---
// Two-tier header: Starlight's normal top bar (title / search / account / theme)
// plus a second-row site nav on desktop. The same links live in the sidebar
// config tagged `site-link` (hidden on desktop, shown in the mobile drawer), so
// nothing is lost on small screens where this nav is hidden.
import Default from '@astrojs/starlight/components/Header.astro';

const links = [
	{ label: 'Home', href: '/' },
	{ label: 'How to use', href: '/how-to-use-these-notes/' },
	{ label: 'Resources', href: '/resources/resources/' },
	{ label: 'Blog', href: '/blog/' },
	{ label: 'About', href: '/about/' },
	{ label: 'Feedback', href: '/feedback/' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<div class="site-header-stack">
	<Default />
	<nav class="site-top-nav" aria-label="Site">
		{links.map((l) => (
			<a
				href={l.href}
				class:list={['site-top-nav__link', { 'is-active': isActive(l.href) }]}
				aria-current={isActive(l.href) ? 'page' : undefined}
			>
				{l.label}
			</a>
		))}
	</nav>
</div>

<style is:global>
	/* Mobile: no second-row nav — those links live in the sidebar drawer. */
	.site-top-nav { display: none; }

	@media (min-width: 50rem) {
		/* Taller fixed header to fit two rows. Everything (sidebar offset, content
		   padding) keys off --sl-nav-height, so it all stays aligned. */
		:root { --sl-nav-height: 6rem; }

		.site-header-stack {
			display: flex;
			flex-direction: column;
			height: 100%;
		}
		/* Row 1: Starlight's own header bar keeps its grid; just fix its height. */
		.site-header-stack > .header {
			height: 3.5rem;
			flex: 0 0 auto;
		}

		.site-top-nav {
			display: flex;
			align-items: center;
			gap: 1.5rem;
			flex: 1 1 auto;
			min-height: 0;
			border-top: 1px solid var(--sl-color-hairline);
			margin-top: 0.15rem;
		}
		.site-top-nav__link {
			font-family: var(--font-ui, sans-serif);
			font-size: var(--sl-text-sm);
			font-weight: 600;
			color: var(--sl-color-text);
			text-decoration: none;
			padding: 0.15rem 0;
			border-bottom: 2px solid transparent;
			white-space: nowrap;
		}
		.site-top-nav__link:hover { color: var(--sl-color-text-accent); }
		.site-top-nav__link.is-active {
			color: var(--sl-color-text-accent);
			border-bottom-color: var(--sl-color-accent);
		}

		/* Hide the duplicated site links from the desktop sidebar (they remain in
		   the mobile drawer, where the top nav is hidden). */
		.sidebar-content a.site-link {
			display: none;
		}
		/* If hiding the first sidebar items leaves a leading gap, keep it tidy. */
		.sidebar-content a.site-link + li { margin-top: 0; }
	}
</style>
