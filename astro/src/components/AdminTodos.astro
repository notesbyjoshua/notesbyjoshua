---
// Admin-only to-do list. Add tasks, check them off when done, delete them.
// Backed by the public.admin_todos table; RLS limits rows to the signed-in
// admin, and the client gate below mirrors that for UX.
---
<div class="todos">
  <p id="todos-status">Loading…</p>

  <div id="todos-denied" hidden>
    <p>This page is for admins only. <a href="/account/">Go to your account</a> to sign in.</p>
  </div>

  <div id="todos-content" hidden>
    <form id="todos-add" class="todos-add">
      <input id="todos-input" type="text" placeholder="Add a task…" autocomplete="off" maxlength="500" required />
      <button type="submit">Add</button>
    </form>

    <ul id="todos-list" class="todos-list"></ul>
    <p id="todos-empty" class="todos-empty" hidden>No tasks yet — add one above.</p>
    <div class="todos-foot">
      <span id="todos-summary" class="todos-summary"></span>
      <button type="button" id="todos-clear" class="todos-clear" hidden>Clear completed</button>
    </div>
  </div>
</div>

<script>
  import { getSupabase, getRole, getCurrentUser, type SessionUser } from '../lib/supabase';

  type Todo = { id: string; title: string; done: boolean; created_at: string };

  const byId = (id: string) => document.getElementById(id)!;
  const STATES = ['todos-status', 'todos-denied', 'todos-content'];
  const show = (id: string) => STATES.forEach((s) => (byId(s).hidden = s !== id));
  const sb = getSupabase();

  const listEl = byId('todos-list') as HTMLUListElement;
  const emptyEl = byId('todos-empty');
  const summaryEl = byId('todos-summary');
  const form = byId('todos-add') as HTMLFormElement;
  const input = byId('todos-input') as HTMLInputElement;
  const clearBtn = byId('todos-clear') as HTMLButtonElement;

  let uid: string | null = null;
  let todos: Todo[] = [];

  // Incomplete first (newest at top), completed below (most recently added first).
  function sortTodos() {
    todos.sort((a, b) => {
      if (a.done !== b.done) return a.done ? 1 : -1;
      return b.created_at.localeCompare(a.created_at);
    });
  }

  function render() {
    sortTodos();
    listEl.innerHTML = '';
    for (const t of todos) {
      const li = document.createElement('li');
      li.className = 'todo' + (t.done ? ' is-done' : '');
      li.dataset.id = t.id;

      const label = document.createElement('label');
      label.className = 'todo-main';
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.checked = t.done;
      box.addEventListener('change', () => toggle(t, box));
      const text = document.createElement('span');
      text.className = 'todo-text';
      text.textContent = t.title;
      label.append(box, text);

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'todo-del';
      del.setAttribute('aria-label', 'Delete task');
      del.title = 'Delete';
      del.textContent = '×';
      del.addEventListener('click', () => remove(t, li));

      li.append(label, del);
      listEl.appendChild(li);
    }
    const open = todos.filter((t) => !t.done).length;
    const done = todos.length - open;
    emptyEl.hidden = todos.length > 0;
    summaryEl.textContent = todos.length ? `${open} open · ${done} done` : '';
    clearBtn.hidden = done === 0;
    clearBtn.textContent = `Clear ${done} completed`;
  }

  async function load() {
    const { data, error } = await sb!
      .from('admin_todos')
      .select('id, title, done, created_at');
    if (error) throw error;
    todos = (data ?? []) as Todo[];
    render();
  }

  async function add(title: string) {
    if (!uid) return;
    // Optimistic insert; reconcile id from the returned row.
    const { data, error } = await sb!
      .from('admin_todos')
      .insert({ user_id: uid, title })
      .select('id, title, done, created_at')
      .single();
    if (error) { console.error('[todos] add failed:', error); return; }
    todos.push(data as Todo);
    render();
  }

  async function toggle(t: Todo, box: HTMLInputElement) {
    const next = box.checked;
    box.disabled = true;
    const { error } = await sb!
      .from('admin_todos')
      .update({ done: next, completed_at: next ? new Date().toISOString() : null })
      .eq('id', t.id);
    box.disabled = false;
    if (error) { console.error('[todos] toggle failed:', error); box.checked = !next; return; }
    t.done = next;
    render();
  }

  async function remove(t: Todo, li: HTMLElement) {
    li.style.opacity = '0.4';
    const { error } = await sb!.from('admin_todos').delete().eq('id', t.id);
    if (error) { console.error('[todos] delete failed:', error); li.style.opacity = '1'; return; }
    todos = todos.filter((x) => x.id !== t.id);
    render();
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const title = input.value.trim();
    if (!title) return;
    input.value = '';
    await add(title);
    input.focus();
  });

  // Bulk-remove every completed task so finished items don't pile up.
  clearBtn.addEventListener('click', async () => {
    const doneIds = todos.filter((t) => t.done).map((t) => t.id);
    if (!doneIds.length) return;
    clearBtn.disabled = true;
    const { error } = await sb!.from('admin_todos').delete().in('id', doneIds);
    clearBtn.disabled = false;
    if (error) { console.error('[todos] clear completed failed:', error); return; }
    todos = todos.filter((t) => !t.done);
    render();
  });

  async function gate(session: { user?: SessionUser } | null) {
    if (!session?.user) { show('todos-denied'); return; }
    let role: string | null = null;
    for (let i = 0; i < 3; i++) {
      try { role = await getRole(session.user); break; }
      catch (err) {
        if (i === 2) { console.error('[todos] role check failed:', err); show('todos-denied'); return; }
        await new Promise((r) => setTimeout(r, 400));
      }
    }
    if (role !== 'admin') { show('todos-denied'); return; }
    uid = session.user.id;
    try {
      await load();
      show('todos-content');
      input.focus();
    } catch (err) {
      console.error('[todos] load failed:', err);
      show('todos-denied');
    }
  }

  if (!sb) {
    show('todos-denied');
  } else {
    getCurrentUser().then((user) => gate(user ? { user } : null)).catch(() => show('todos-denied'));
    sb.auth.onAuthStateChange((event, session) => { if (event !== 'INITIAL_SESSION') gate(session); });
  }
</script>

<style>
  .todos-add { display: flex; gap: 0.5rem; margin-bottom: 1.25rem; }
  .todos-add input {
    flex: 1; min-width: 0; height: 2.4rem; padding: 0 0.7rem;
    border: 1px solid var(--sl-color-gray-5); border-radius: 0.4rem;
    background: var(--sl-color-black); color: var(--sl-color-white); font: inherit;
  }
  .todos-add button {
    height: 2.4rem; padding: 0 1.1rem; border: 1px solid var(--sl-color-accent);
    background: var(--sl-color-accent); color: var(--sl-color-white);
    border-radius: 0.4rem; cursor: pointer; font: inherit; font-weight: 600;
  }

  .todos-list { list-style: none; margin: 0; padding: 0; }
  /* Uniform rows: same min-height regardless of 1- or 2-line text, even gaps. */
  .todo {
    display: flex; align-items: center; gap: 1rem;
    min-height: 3rem; padding: 0.4rem 0.25rem;
    border-bottom: 1px solid var(--sl-color-gray-6);
  }
  .todo-main { display: flex; align-items: center; gap: 0.85rem; flex: 1; min-width: 0; cursor: pointer; margin: 0; }
  .todo-main input { width: 1.2rem; height: 1.2rem; flex: none; cursor: pointer; accent-color: var(--sl-color-accent); }
  .todo-text { flex: 1; min-width: 0; word-break: break-word; line-height: 1.4; }
  .todo.is-done .todo-text { text-decoration: line-through; color: var(--sl-color-gray-3); }
  /* Delete button: clearly separated on the right, obvious on hover. */
  .todo-del {
    flex: none; width: 2rem; height: 2rem; line-height: 1; font-size: 1.35rem;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--sl-color-gray-5); border-radius: 0.4rem; background: transparent;
    color: var(--sl-color-gray-2); cursor: pointer;
  }
  .todo-del:hover { color: #fff; background: #ef4444; border-color: #ef4444; }

  .todos-empty { color: var(--sl-color-gray-3); }
  .todos-foot {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    margin-top: 1.1rem; flex-wrap: wrap;
  }
  .todos-summary { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
  .todos-clear {
    padding: 0.35rem 0.8rem; font: inherit; font-size: var(--sl-text-sm); font-weight: 600;
    border: 1px solid var(--sl-color-gray-5); border-radius: 0.4rem;
    background: transparent; color: var(--sl-color-text-accent); cursor: pointer;
  }
  .todos-clear:hover:not(:disabled) { background: var(--sl-color-gray-6); }
  .todos-clear:disabled { opacity: 0.5; cursor: not-allowed; }
</style>
