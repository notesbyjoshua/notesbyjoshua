---
// Desktop-only minimap: a scaled preview of the note with a draggable viewport
// band, heading labels, and scroll-spy (logic in scripts/minimap.ts). Ported
// from gxboy12345's fork. On wide screens it replaces Starlight's text "On this
// page" TOC (it covers the same headings plus a visual preview); on smaller
// screens / reduced-motion it stays hidden and the normal TOC shows.
---

<aside class="doc-minimap" data-doc-minimap aria-label="Page minimap" hidden>
	<div class="doc-minimap__preview" data-minimap-preview>
		<div class="doc-minimap__viewport" data-minimap-viewport aria-hidden="true"></div>
		<nav class="doc-minimap__labels" data-minimap-labels aria-label="Headings"></nav>
	</div>
</aside>

<script>
	import { initMinimap } from '../scripts/minimap';
	initMinimap();
</script>

<style is:global>
	.doc-minimap {
		position: fixed;
		top: calc(var(--sl-nav-height, 4rem) + 1rem);
		right: 0.75rem;
		width: 12rem;
		height: min(76vh, calc(100vh - var(--sl-nav-height, 4rem) - 3rem));
		z-index: 5;
		contain: layout paint style;
		user-select: none;
		touch-action: none;
		--minimap-rail-inset: 14px;
	}
	.doc-minimap[hidden] { display: none; }

	.doc-minimap__preview {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		cursor: pointer;
		contain: strict;
	}

	.doc-minimap__viewport {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: 36px;
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
		border-radius: 0.35rem;
		background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--sl-color-bg) 35%, transparent) inset;
		pointer-events: auto;
		cursor: grab;
		z-index: 2;
	}
	.doc-minimap[data-dragging='true'] .doc-minimap__viewport { cursor: grabbing; }

	.doc-minimap__labels { position: absolute; inset: 0; pointer-events: none; z-index: 3; }
	.doc-minimap__label {
		position: absolute;
		left: 0.2rem;
		right: 0.2rem;
		max-width: calc(100% - 0.4rem);
		transform: translateY(-50%);
		font-family: var(--font-ui, sans-serif);
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1.1;
		color: var(--sl-color-text);
		text-decoration: none;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		pointer-events: auto;
		cursor: pointer;
		text-shadow: 0 0 4px var(--sl-color-bg), 0 0 8px var(--sl-color-bg), 0 0 14px var(--sl-color-bg);
	}
	.doc-minimap__label[data-depth='3'] {
		left: 0.7rem;
		max-width: calc(100% - 0.9rem);
		font-size: 0.66rem;
		font-weight: 600;
	}
	.doc-minimap__label[data-active='true'] { color: var(--sl-color-accent); }
	.doc-minimap__label:hover { color: var(--sl-color-accent); }
	.doc-minimap__label::before {
		content: '';
		display: inline-block;
		width: 0.3rem;
		height: 1px;
		margin-right: 0.25rem;
		vertical-align: middle;
		background: currentColor;
		opacity: 0.7;
	}
	.doc-minimap__label[data-depth='2']::before { width: 0.45rem; height: 2px; opacity: 0.85; }

	/* Disable interaction on cloned content. */
	.doc-minimap__clone :is(a, button, input, textarea, select, summary) { pointer-events: none !important; }
	.doc-minimap__clone :is(input, textarea, select, button) { visibility: hidden; }

	/* When the minimap is active, hand the right column over to it: hide
	   Starlight's text TOC (the minimap shows the same headings + a preview). */
	@media (min-width: 1200px) {
		html.has-minimap .right-sidebar-panel { display: none; }
	}
	/* Safety: never show the minimap below the desktop breakpoint or under
	   reduced motion, even if a stale class lingers. */
	@media (max-width: 1199.98px) {
		.doc-minimap { display: none !important; }
	}
	@media (prefers-reduced-motion: reduce) {
		.doc-minimap { display: none !important; }
		html.has-minimap .right-sidebar-panel { display: revert; }
	}
</style>
