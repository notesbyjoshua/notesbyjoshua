---
// Override of Starlight's <Head> — used as a universal mount point (it renders
// on every page, splash + docs) for the animated "paper canvas" background, and
// to emit JSON-LD structured data on note pages so search engines understand
// them as free learning resources / articles.
import Default from '@astrojs/starlight/components/Head.astro';

const SITE_URL = 'https://notesbyjoshua.github.io';
const route = (Astro.locals as any).starlightRoute;
const entry = route?.entry;
const isNote = Astro.url.pathname.startsWith('/notes/');
const isHome = Astro.url.pathname === '/';

// The desktop minimap replaces Starlight's text TOC, but it's built by JS after
// load — so without this the default TOC paints first and then gets swapped for
// the minimap (a visible flash on every navigation). Mirror the minimap's
// eligibility (≥2 h2/h3 headings) and add `has-minimap` before paint via a
// render-blocking inline script. The CSS only acts on it at ≥1200px and reverts
// it under reduced motion, so this is inert on mobile / reduced-motion; minimap.ts
// then owns the class from there.
const headings = (route?.headings ?? []) as Array<{ depth: number }>;
const willHaveMinimap = isNote && headings.filter((h) => h.depth === 2 || h.depth === 3).length >= 2;

let jsonLd: string | null = null;
if (isHome) {
  const schema = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Notes by Joshua',
    alternateName: 'Joshua Notes',
    url: SITE_URL,
  };
  jsonLd = JSON.stringify(schema).replace(/</g, '\\u003c');
} else if (isNote && entry) {
  const data = entry.data ?? {};
  const canonical = new URL(Astro.url.pathname, SITE_URL).href;
  const lastUpdated = route?.lastUpdated instanceof Date ? route.lastUpdated.toISOString() : undefined;
  const schema = {
    '@context': 'https://schema.org',
    '@type': ['LearningResource', 'Article'],
    name: data.title,
    headline: data.title,
    ...(data.description ? { description: data.description } : {}),
    url: canonical,
    inLanguage: 'en',
    isAccessibleForFree: true,
    learningResourceType: 'Study notes',
    ...(lastUpdated ? { dateModified: lastUpdated } : {}),
    author: { '@type': 'Person', name: 'Joshua' },
    publisher: { '@type': 'Organization', name: 'Notes by Joshua', url: SITE_URL },
    isPartOf: { '@type': 'WebSite', name: 'Notes by Joshua', url: SITE_URL },
  };
  // Escape `<` so a stray "</script>" in a title can't break out of the tag.
  jsonLd = JSON.stringify(schema).replace(/</g, '\\u003c');
}
---

<script is:inline>
	(() => {
		const key = 'notesbyjoshua-theme';
		const allowed = new Set(['handwritten', 'focus', 'blueprint', 'nebula']);
		let theme = 'handwritten';
		try {
			const saved = localStorage.getItem(key);
			if (saved === 'default' || saved === 'clean') theme = 'focus';
			else if (saved === 'classic') theme = 'nebula';
			else if (allowed.has(saved)) theme = saved;
		} catch {}
		document.documentElement.dataset.noteTheme = theme;
	})();
</script>
<Default><slot /></Default>
{willHaveMinimap && <script is:inline>document.documentElement.classList.add("has-minimap")</script>}
{jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}

<script>
  import { mountPaperCanvas } from '../scripts/paper-canvas';
  mountPaperCanvas();
</script>
