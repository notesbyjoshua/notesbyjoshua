---
/*
 * Theme controls — overrides Starlight's default <select> theme picker
 * (registered in astro.config.mjs `components.ThemeSelect`).
 *
 * The button is a light↔dark toggle that integrates with Starlight's own
 * theming rather than fighting it:
 *   - reads/writes localStorage['starlight-theme'] (Starlight's key)
 *   - sets document.documentElement.dataset.theme
 * so Starlight's no-FOUC inline ThemeProvider applies the saved choice on load.
 *
 * The select controls our own visual note theme:
 *   - reads/writes localStorage['notesbyjoshua-theme']
 *   - sets document.documentElement.dataset.noteTheme
 */
---

<div class="theme-controls" aria-label="Theme controls">
	<button
		type="button"
		class="theme-switch"
		data-theme-toggle
		aria-label="Toggle color theme"
		aria-pressed="false"
	>
		<span class="theme-switch__track" aria-hidden="true">
			<span class="theme-switch__sky theme-switch__sky--day"></span>
			<span class="theme-switch__sky theme-switch__sky--night"></span>
			<span class="theme-switch__stars"></span>
			<span class="theme-switch__eclipse"></span>
		</span>
	</button>

	<div class="visual-theme" data-visual-theme-control>
		<button
			type="button"
			class="visual-theme__button"
			data-visual-theme-toggle
			aria-haspopup="listbox"
			aria-expanded="false"
		>
			<span class="sr-only">Visual theme</span>
			<span data-visual-theme-label>Handwritten</span>
		</button>
		<div class="visual-theme__menu" data-visual-theme-menu role="listbox" aria-label="Visual theme" hidden>
			<button type="button" role="option" data-visual-theme-option value="handwritten">Handwritten</button>
			<button type="button" role="option" data-visual-theme-option value="focus">Focus</button>
			<button type="button" role="option" data-visual-theme-option value="blueprint">Blueprint</button>
			<button type="button" role="option" data-visual-theme-option value="nebula">Nebula</button>
		</div>
	</div>
</div>

<script>
	type Theme = 'light' | 'dark';
	type VisualTheme = 'handwritten' | 'focus' | 'blueprint' | 'nebula';
	const STORAGE_KEY = 'starlight-theme';
	const VISUAL_THEME_KEY = 'notesbyjoshua-theme';
	const VISUAL_THEMES = new Set<VisualTheme>(['handwritten', 'focus', 'blueprint', 'nebula']);
	const VISUAL_THEME_LABELS: Record<VisualTheme, string> = {
		handwritten: 'Handwritten',
		focus: 'Focus',
		blueprint: 'Blueprint',
		nebula: 'Nebula',
	};

	const currentTheme = (): Theme =>
		document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
	const currentVisualTheme = (): VisualTheme => {
		const theme = document.documentElement.dataset.noteTheme;
		if (theme === 'default' || theme === 'clean') return 'focus';
		if (theme === 'classic') return 'nebula';
		return VISUAL_THEMES.has(theme as VisualTheme) ? (theme as VisualTheme) : 'handwritten';
	};

	function applyTheme(theme: Theme) {
		document.documentElement.dataset.theme = theme;
		try {
			localStorage.setItem(STORAGE_KEY, theme);
		} catch {
			/* storage may be unavailable (private mode) — theme still applies for the session */
		}
	}

	function syncSwitch(btn: HTMLButtonElement) {
		const dark = currentTheme() === 'dark';
		btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
		btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
	}

	function applyVisualTheme(theme: VisualTheme) {
		document.documentElement.dataset.noteTheme = theme;
		try {
			localStorage.setItem(VISUAL_THEME_KEY, theme);
		} catch {
			/* storage may be unavailable (private mode) — theme still applies for the session */
		}
	}

	function closeVisualMenus(except?: HTMLElement) {
		document.querySelectorAll<HTMLElement>('[data-visual-theme-control]').forEach((control) => {
			if (control === except) return;
			control.querySelector<HTMLElement>('[data-visual-theme-menu]')!.hidden = true;
			control.querySelector<HTMLButtonElement>('[data-visual-theme-toggle]')!.setAttribute('aria-expanded', 'false');
		});
	}

	function syncVisualControl(control: HTMLElement) {
		const theme = currentVisualTheme();
		const label = control.querySelector<HTMLElement>('[data-visual-theme-label]')!;
		label.textContent = VISUAL_THEME_LABELS[theme];
		control.querySelectorAll<HTMLButtonElement>('[data-visual-theme-option]').forEach((option) => {
			const selected = option.value === theme;
			option.setAttribute('aria-selected', String(selected));
			option.classList.toggle('is-selected', selected);
		});
	}

	function bind() {
		// Starlight renders the picker in both the header and the mobile menu.
		const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
		buttons.forEach((btn) => {
			syncSwitch(btn);
			if (btn.dataset.bound === '1') return;
			btn.dataset.bound = '1';

			btn.addEventListener('click', () => {
				applyTheme(currentTheme() === 'dark' ? 'light' : 'dark');
				// Keep every instance (header + mobile) in sync.
				document
					.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
					.forEach(syncSwitch);
				// Replay the little "snap" animation.
				btn.classList.remove('theme-switch--snap');
				void btn.offsetWidth;
				btn.classList.add('theme-switch--snap');
			});
		});

		const controls = document.querySelectorAll<HTMLElement>('[data-visual-theme-control]');
		controls.forEach((control) => {
			syncVisualControl(control);
			if (control.dataset.bound === '1') return;
			control.dataset.bound = '1';

			const toggle = control.querySelector<HTMLButtonElement>('[data-visual-theme-toggle]')!;
			const menu = control.querySelector<HTMLElement>('[data-visual-theme-menu]')!;

			toggle.addEventListener('click', (event) => {
				event.stopPropagation();
				const opening = menu.hidden;
				closeVisualMenus(control);
				menu.hidden = !opening;
				toggle.setAttribute('aria-expanded', String(opening));
			});

			menu.querySelectorAll<HTMLButtonElement>('[data-visual-theme-option]').forEach((option) => {
				option.addEventListener('click', () => {
					const theme = option.value as VisualTheme;
					if (!VISUAL_THEMES.has(theme)) return;
					applyVisualTheme(theme);
					document.querySelectorAll<HTMLElement>('[data-visual-theme-control]').forEach(syncVisualControl);
					menu.hidden = true;
					toggle.setAttribute('aria-expanded', 'false');
					toggle.focus();
				});
			});
		});
	}

	bind();
	document.addEventListener('click', () => closeVisualMenus());
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeVisualMenus();
	});
	// Re-bind after Starlight's view-transition navigations.
	document.addEventListener('astro:page-load', bind);
</script>
