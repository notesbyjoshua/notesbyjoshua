---
// A profile header: avatar (or generated initial), name, role, an intro (the
// default slot), and a row of links. Used on the About page; reusable anywhere.
interface Props {
	name: string;
	role?: string;
	avatar?: string;
	links?: { label: string; href: string; external?: boolean }[];
}
const { name, role, avatar, links } = Astro.props;
const initial = name.trim().charAt(0).toUpperCase();
---

<div class="mdx-profile not-content">
	<div class="mdx-profile__avatar" aria-hidden="true">
		{avatar ? <img src={avatar} alt="" /> : <span>{initial}</span>}
	</div>
	<div class="mdx-profile__body">
		<p class="mdx-profile__name">
			{name}
			{role && <span class="mdx-profile__role">{role}</span>}
		</p>
		<div class="mdx-profile__intro"><slot /></div>
		{links && links.length > 0 && (
			<ul class="mdx-profile__links">
				{links.map((l) => (
					<li>
						<a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
							{l.label}
						</a>
					</li>
				))}
			</ul>
		)}
	</div>
</div>

<style>
	.mdx-profile {
		display: flex;
		gap: 1.1rem;
		align-items: flex-start;
		margin: 1.5rem 0 2rem;
		padding: 1.2rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.9rem;
		background: var(--sl-color-bg-nav);
	}
	.mdx-profile__avatar {
		flex: none;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 50%;
		overflow: hidden;
		display: grid;
		place-items: center;
		background: var(--sl-color-accent);
		color: var(--sl-color-white);
		font-family: var(--font-display, sans-serif);
		font-size: 2.2rem;
		font-weight: 700;
	}
	.mdx-profile__avatar img { width: 100%; height: 100%; object-fit: cover; }
	.mdx-profile__name {
		margin: 0;
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		flex-wrap: wrap;
		font-family: var(--font-display, inherit);
		font-size: 1.6rem;
		font-weight: 700;
	}
	.mdx-profile__role {
		font-family: var(--font-ui, sans-serif);
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--sl-color-text-accent);
	}
	.mdx-profile__intro { margin-top: 0.25rem; }
	.mdx-profile__intro :global(> :first-child) { margin-top: 0.3rem; }
	.mdx-profile__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1rem;
		margin: 0.6rem 0 0;
		padding: 0;
		list-style: none;
		font-weight: 600;
		font-size: var(--sl-text-sm);
	}
	@media (max-width: 30rem) {
		.mdx-profile { flex-direction: column; }
	}
</style>
