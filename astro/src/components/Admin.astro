---
// Admin-only dashboard. Access is enforced by RLS (admins can read all
// profiles; visitors cannot), with this client-side gate for UX.
---
<div class="admin-dash">
  <p id="admin-status">Loading…</p>

  <div id="admin-denied" hidden>
    <p>This page is for admins only. <a href="/account/">Go to your account</a> to sign in.</p>
    <p id="admin-why" class="admin-why" hidden></p>
  </div>

  <div id="admin-content" hidden>
    <p><a href="/admin/edit/">Edit notes in the browser →</a></p>
    <p><a href="/admin/todos/">To-do list →</a></p>
    <p><a href="/admin/progress/">View notes completion progress →</a></p>
    <p><a href="/admin/feedback/">View submitted feedback →</a></p>
    <p id="admin-summary"></p>
    <div class="table-scroll">
      <table class="admin-users">
        <thead>
          <tr><th>Email</th><th>Role</th><th>Writer topics</th><th>Joined</th><th></th></tr>
        </thead>
        <tbody id="admin-users-body"></tbody>
      </table>
    </div>
  </div>
</div>

<script>
  import { getSupabase, getRole, getCurrentUser } from '../lib/supabase';
  import { EDITABLE_TOPICS } from '../lib/editorTopics';

  const byId = (id: string) => document.getElementById(id)!;
  const STATES = ['admin-status', 'admin-denied', 'admin-content'];
  const show = (id: string) => STATES.forEach((s) => (byId(s).hidden = s !== id));
  const sb = getSupabase();
  const topicKeys = new Set(EDITABLE_TOPICS.map((topic) => topic.key));

  function makeRoleSelect(role: string) {
    const select = document.createElement('select');
    select.className = 'admin-role-select';
    for (const value of ['visitor', 'writer', 'admin']) {
      const option = document.createElement('option');
      option.value = value;
      option.textContent = value;
      option.selected = role === value;
      select.appendChild(option);
    }
    return select;
  }

  function makeTopicChecks(selected: Set<string>) {
    const wrap = document.createElement('div');
    wrap.className = 'admin-topic-checks';
    for (const topic of EDITABLE_TOPICS) {
      const label = document.createElement('label');
      const input = document.createElement('input');
      input.type = 'checkbox';
      input.value = topic.key;
      input.checked = selected.has(topic.key);
      label.append(input, document.createTextNode(topic.label));
      wrap.appendChild(label);
    }
    return wrap;
  }

  async function saveUserRow(tr: HTMLTableRowElement) {
    const userId = tr.dataset.userId!;
    const role = (tr.querySelector('.admin-role-select') as HTMLSelectElement).value;
    const checked = Array.from(tr.querySelectorAll<HTMLInputElement>('.admin-topic-checks input:checked'))
      .map((input) => input.value)
      .filter((key) => topicKeys.has(key));
    const status = tr.querySelector<HTMLElement>('.admin-save-status')!;
    status.textContent = 'Saving...';

    const { error: roleError } = await sb!
      .from('profiles')
      .update({ role })
      .eq('id', userId);
    if (roleError) throw roleError;

    const { data: existing, error: existingError } = await sb!
      .from('writer_topic_permissions')
      .select('topic_key')
      .eq('user_id', userId);
    if (existingError) throw existingError;

    const existingKeys = new Set((existing ?? []).map((row: any) => String(row.topic_key)));
    const selectedKeys = new Set(checked);
    const toAdd = checked.filter((key) => !existingKeys.has(key));
    const toRemove = Array.from(existingKeys).filter((key) => !selectedKeys.has(key));

    if (toAdd.length) {
      const { error } = await sb!
        .from('writer_topic_permissions')
        .upsert(toAdd.map((topic_key) => ({ user_id: userId, topic_key })));
      if (error) throw error;
    }
    if (toRemove.length) {
      const { error } = await sb!
        .from('writer_topic_permissions')
        .delete()
        .eq('user_id', userId)
        .in('topic_key', toRemove);
      if (error) throw error;
    }

    status.textContent = 'Saved';
    setTimeout(() => { if (status.textContent === 'Saved') status.textContent = ''; }, 1800);
  }

  async function loadUsers() {
    const { data, error } = await sb!
      .from('profiles')
      .select('id, email, role, created_at')
      .order('created_at', { ascending: true });
    if (error) throw error;
    const { data: perms, error: permsError } = await sb!
      .from('writer_topic_permissions')
      .select('user_id, topic_key');
    if (permsError) throw permsError;

    const topicsByUser = new Map<string, Set<string>>();
    for (const perm of perms ?? []) {
      const userId = String((perm as any).user_id);
      if (!topicsByUser.has(userId)) topicsByUser.set(userId, new Set());
      topicsByUser.get(userId)!.add(String((perm as any).topic_key));
    }

    const body = byId('admin-users-body');
    body.innerHTML = '';
    for (const u of data ?? []) {
      const joined = u.created_at ? new Date(u.created_at).toLocaleDateString() : '';
      const tr = document.createElement('tr');
      tr.dataset.userId = u.id;

      const emailTd = document.createElement('td');
      emailTd.textContent = u.email ?? '';
      tr.appendChild(emailTd);

      const roleTd = document.createElement('td');
      roleTd.appendChild(makeRoleSelect(u.role));
      tr.appendChild(roleTd);

      const topicsTd = document.createElement('td');
      topicsTd.appendChild(makeTopicChecks(topicsByUser.get(u.id) ?? new Set()));
      tr.appendChild(topicsTd);

      const joinedTd = document.createElement('td');
      joinedTd.textContent = joined;
      tr.appendChild(joinedTd);

      const actionTd = document.createElement('td');
      const save = document.createElement('button');
      save.type = 'button';
      save.className = 'admin-save-user';
      save.textContent = 'Save';
      const status = document.createElement('span');
      status.className = 'admin-save-status';
      save.addEventListener('click', async () => {
        save.disabled = true;
        try { await saveUserRow(tr); }
        catch (err: any) {
          console.error('[admin] save user failed:', err);
          status.textContent = `Error: ${err.message ?? err}`;
        } finally {
          save.disabled = false;
        }
      });
      actionTd.append(save, status);
      tr.appendChild(actionTd);

      body.appendChild(tr);
    }
    byId('admin-summary').textContent = `${data?.length ?? 0} registered user(s).`;
  }

  // Show the denied screen with a visible reason (so a silent client-side
  // failure can be diagnosed without the browser console).
  function deny(reason: string) {
    const why = byId('admin-why');
    why.textContent = `Diagnostic: ${reason}`;
    why.hidden = false;
    console.error('[admin] denied:', reason);
    show('admin-denied');
  }

  async function gate(session: any) {
    if (!session?.user) { deny('no active session detected in this browser (signed out or token refresh failed).'); return; }
    // Pass the session user (no auth-method call inside this callback, which can
    // deadlock) and retry a transient role read before denying.
    let role: string | null = null;
    let lastErr: any = null;
    for (let i = 0; i < 3; i++) {
      try { role = await getRole(session.user); break; }
      catch (err) {
        lastErr = err;
        if (i === 2) { deny(`couldn't read your profile: ${err?.message ?? err}`); return; }
        await new Promise((r) => setTimeout(r, 400));
      }
    }
    if (role !== 'admin') {
      deny(`signed in as ${session.user.email ?? '(unknown email)'}, role = "${role ?? 'unknown'}"${lastErr ? ` (last error: ${lastErr.message ?? lastErr})` : ''}.`);
      return;
    }
    try {
      await loadUsers();
      show('admin-content');
    } catch (err: any) {
      deny(`role is admin, but loading the user list failed: ${err?.message ?? err}`);
    }
  }

  if (!sb) {
    show('admin-denied');
  } else {
    // Decide once from the restored session (reliable even if the auth event is
    // slow/missing), then keep responding to later sign-in/out changes.
    getCurrentUser().then((user) => gate(user ? { user } : null)).catch(() => show('admin-denied'));
    sb.auth.onAuthStateChange((event, session) => { if (event !== 'INITIAL_SESSION') gate(session); });
  }
</script>

<style>
  .admin-why {
    margin-top: 0.75rem;
    padding: 0.6rem 0.8rem;
    border-left: 3px solid var(--sl-color-orange, #f59e0b);
    background: var(--sl-color-gray-6);
    font-size: var(--sl-text-sm);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--sl-color-gray-2);
    word-break: break-word;
  }
</style>
